{
  "name": "ynapb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:arch": "depcruise --config .dependency-cruiser.cjs src",
    "test:duplication": "jscpd --config .jscpd.json src",
    "test:e2e": "playwright test",
    "test:spelling": "cspell lint --config cspell.config.yaml \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test:security": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:arch && npm run test:unit",
    "quality:quick": "npm run format:check && npm run lint && npm run typecheck",
    "quality:full": "npm run quality:quick && npm run test:arch && npm run test:unit:coverage && npm run test:spelling && npm run test:duplication && npm run test:e2e && npm run test:security"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@dnd-kit/core": "6.3.1",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.104.1",
    "@tanstack/react-query": "5.100.3",
    "@tanstack/react-virtual": "3.13.24",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.11.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1",
    "shadcn": "4.5.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "ynab": "4.1.0",
    "zod": "4.0.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "4.1.5",
    "cspell": "^10.0.0",
    "dependency-cruiser": "17.3.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "jscpd": "^4.0.9",
    "jsdom": "26.1.0",
    "msw": "2.8.0",
    "prettier": "3.5.0",
    "supabase": "^2.95.3",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  }
}
